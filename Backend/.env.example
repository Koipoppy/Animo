# Copy to .env and fill in. .env is git-ignored; never commit it or ship it in a source zip.
PORT=8787

# Bind address. Default is loopback for adb reverse; Docker/Caddy sets 0.0.0.0.
# HOST=0.0.0.0

# Behind Caddy/Nginx set 1 so per-IP quotas read X-Forwarded-For. Never enable this
# when port 8787 is exposed directly: clients could spoof the header and reset quotas.
# TRUST_PROXY=1

# Aholo open-platform API key. Sent as the raw Authorization header (no "Bearer" prefix).
# Leave empty to run in demo mode, which never calls Lux3D.
LUX3D_API_KEY=

# Optional: require this value in the X-Animo-Secret header. Note that a secret
# shipped inside an APK can be extracted; use it only for private/closed testing.
# CLIENT_SHARED_SECRET=

# LUX3D_VERSION=G1-Turbo
# LUX3D_FACE_COUNT=30000
# MAX_JOBS_PER_IP_PER_DAY=30
# JOB_CONCURRENCY=1
# DATA_DIR=data

# Lux3D rigs and retargets humanoid models directly; no extra service is needed.
# LUX3D_RIG_TIMEOUT_SECONDS=480   # per rig/retarget task
# RIG_DISABLED=1                  # skip cloud rigging and the local Blender fallback
# BLENDER_PATH=/usr/bin/blender   # optional fallback for non-humanoid models
