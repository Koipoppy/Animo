# Copy to android/keystore.properties (git-ignored) and fill in.
# Generate a key once; losing it means you can never update the app on stores:
#
#   keytool -genkeypair -v -keystore android/animo-release.jks -alias animo \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the android/ directory.
storeFile=animo-release.jks
storePassword=CHANGE_ME
keyAlias=animo
keyPassword=CHANGE_ME
