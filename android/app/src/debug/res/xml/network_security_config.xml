<?xml version="1.0" encoding="utf-8"?>
<!-- Debug: same private CA, plus cleartext for adb reverse / LAN development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/animo_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
